# Host identity
TZ=America/Chicago
PUID=1000
PGID=1000

# USB-backed storage mount points on the host
UPLOAD_LOCATION=/mnt/photos
JELLYFIN_MEDIA_SOURCE=/mnt/media/jellyfin
JELLYFIN_MEDIA_TARGET=/mnt/media/jellyfin

# Keep the database on the internal system disk, not on a removable USB drive
DB_DATA_LOCATION=/srv/immich/postgres

# Immich
IMMICH_VERSION=release
DB_PASSWORD=changeMeToALongAlphaNumericPassword
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# Jellyfin
JELLYFIN_UID=998
JELLYFIN_GID=998
JELLYFIN_CONFIG_DIR=/etc/jellyfin
JELLYFIN_CACHE_DIR=/var/cache/jellyfin
JELLYFIN_DATA_DIR=/var/lib/jellyfin
JELLYFIN_LOG_DIR=/var/log/jellyfin
JELLYFIN_PUBLISHED_SERVER_URL=http://192.168.1.10:8096

# Piper
PIPER_VOICE=en_US-lessac-medium
